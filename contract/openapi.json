{
  "components": {
    "schemas": {
      "AssignmentResponse": {
        "properties": {
          "demonstration_only": {
            "default": true,
            "title": "Demonstration Only",
            "type": "boolean"
          },
          "description": {
            "default": "Engineering demonstration only; professional review required before patient use.",
            "title": "Description",
            "type": "string"
          },
          "exercise_id": {
            "const": "elbow_flexion_extension",
            "title": "Exercise Id",
            "type": "string"
          },
          "extended_threshold_degrees": {
            "default": 150.0,
            "title": "Extended Threshold Degrees",
            "type": "number"
          },
          "flexed_threshold_degrees": {
            "default": 70.0,
            "title": "Flexed Threshold Degrees",
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "instructions": {
            "default": [
              "Demonstration defaults requiring professional review before patient use.",
              "For this engineering demo, keep shoulder, elbow and wrist visible.",
              "Demonstration: extend the elbow, flex it, then extend to complete one cycle.",
              "Stop the demonstration if uncomfortable. This is not a treatment prescription."
            ],
            "items": {
              "type": "string"
            },
            "title": "Instructions",
            "type": "array"
          },
          "professional_review_required": {
            "default": true,
            "title": "Professional Review Required",
            "type": "boolean"
          },
          "target_repetitions": {
            "default": 10,
            "title": "Target Repetitions",
            "type": "integer"
          },
          "title": {
            "default": "Elbow flexion / extension demonstration",
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "exercise_id"
        ],
        "title": "AssignmentResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "SessionCreate": {
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "format": "uuid",
            "title": "Assignment Id",
            "type": "string"
          },
          "client_session_id": {
            "format": "uuid",
            "title": "Client Session Id",
            "type": "string"
          },
          "completed_repetitions": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Completed Repetitions",
            "type": "integer"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "exercise_id": {
            "const": "elbow_flexion_extension",
            "title": "Exercise Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "stop_reason": {
            "enum": [
              "user_stopped",
              "tracking_lost",
              "app_inactive"
            ],
            "title": "Stop Reason",
            "type": "string"
          },
          "tracking_mode": {
            "enum": [
              "simulated",
              "camera"
            ],
            "title": "Tracking Mode",
            "type": "string"
          }
        },
        "required": [
          "client_session_id",
          "assignment_id",
          "exercise_id",
          "started_at",
          "ended_at",
          "completed_repetitions",
          "tracking_mode",
          "stop_reason"
        ],
        "title": "SessionCreate",
        "type": "object"
      },
      "SessionHistory": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/SessionResponse"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "SessionHistory",
        "type": "object"
      },
      "SessionResponse": {
        "additionalProperties": false,
        "properties": {
          "assignment_id": {
            "format": "uuid",
            "title": "Assignment Id",
            "type": "string"
          },
          "client_session_id": {
            "format": "uuid",
            "title": "Client Session Id",
            "type": "string"
          },
          "completed_repetitions": {
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Completed Repetitions",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "ended_at": {
            "format": "date-time",
            "title": "Ended At",
            "type": "string"
          },
          "exercise_id": {
            "const": "elbow_flexion_extension",
            "title": "Exercise Id",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "title": "Started At",
            "type": "string"
          },
          "stop_reason": {
            "enum": [
              "user_stopped",
              "tracking_lost",
              "app_inactive"
            ],
            "title": "Stop Reason",
            "type": "string"
          },
          "tracking_mode": {
            "enum": [
              "simulated",
              "camera"
            ],
            "title": "Tracking Mode",
            "type": "string"
          }
        },
        "required": [
          "client_session_id",
          "assignment_id",
          "exercise_id",
          "started_at",
          "ended_at",
          "completed_repetitions",
          "tracking_mode",
          "stop_reason",
          "id",
          "created_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "TokenResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Android-first, online-only engineering demonstration. One elbow exercise; all defaults require professional review before patient use. No camera frames are accepted. Backend owns this contract.",
    "title": "Restora demonstration API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing, invalid, or expired bearer token"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Resource not found for the authenticated account"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Client session UUID already used for a different summary"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server failure"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Database unavailable or migrations not ready"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
